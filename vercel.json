{
  "framework": "vite",
  "buildCommand": "npm test && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/auth",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/zh-tw/auth",
      "destination": "/index.html"
    },
    {
      "source": "/zh-tw/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/zh-tw/profile",
      "destination": "/index.html"
    },
    {
      "source": "/ar/auth",
      "destination": "/index.html"
    },
    {
      "source": "/ar/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/ar/profile",
      "destination": "/index.html"
    },
    {
      "source": "/ur/auth",
      "destination": "/index.html"
    },
    {
      "source": "/ur/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/ur/profile",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://kanwar-hub.vercel.app https://localhost capacitor://localhost"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/auth",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/profile",
